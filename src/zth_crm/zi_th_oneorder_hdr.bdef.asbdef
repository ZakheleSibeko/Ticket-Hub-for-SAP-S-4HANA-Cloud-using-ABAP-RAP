managed implementation in class zbp_i_th_oneorder_hdr unique;
strict ( 2 );

define behavior for ZI_TH_ONEORDER_HDR alias Header
persistent table zth_oneorder_hdr
lock master
authorization master ( instance )
//etag master <field_name>
{
  create ( authorization : global );
  update;
  delete;

  field ( readonly, numbering : managed ) Guid;

  action ( features : instance) submit result [1] $self;

  determination setInitialStatus on modify { create; }

  validation checkmandatoryPartners on save { create; update; }

  association _Appoitment { create; }
  association _Item { create; }
  association _Partner { create; }
  association _Pricing { create; }
  association _Status { create; }
  association _Text { create; }

  mapping for zth_oneorder_hdr {
          Guid        = guid;
          Description = description;
          ProcessType = process_type;
          Status      = status;
          CreatedBy   = created_by;
          CreatedAt   = created_at;
  }
}

define behavior for ZI_TH_ONEORDER_APPT alias Appointment
