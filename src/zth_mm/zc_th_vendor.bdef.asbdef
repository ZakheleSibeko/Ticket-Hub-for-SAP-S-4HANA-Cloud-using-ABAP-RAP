projection;
strict ( 2 );
use draft;

define behavior for ZC_TH_VENDOR alias Vendor
{
  use create;
  use update;
  use delete;

  use action RegisterVendor;
  use action DeleteVendor;
  use action ActivateVendor;

  use action Edit;
  use action Activate;
  use action Resume;
  use action Discard;
  use action Prepare;
}