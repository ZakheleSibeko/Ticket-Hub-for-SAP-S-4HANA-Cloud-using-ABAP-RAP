managed implementation in class zbp_i_th_event unique;
strict ( 2 );

with draft;

define behavior for ZI_TH_EVENT alias Event
persistent table zth_event
draft table zth_event_d
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create ( authorization : global );
  update;
  delete;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  draft determine action Prepare
  {
  validation ValidateEventDates;
  validation ValidateCapacity;
  validation ValidateEventText;
  validation ValidateEventReadiness;

  validation Booking~ValidateBookingCanIssues;
  validation BookingItem~ValidateItemQuantity;
  }

  field ( readonly, numbering : managed ) EventId;
  field ( readonly ) CreatedAt, CreatedBy, LastChangedAt, LastChangedBy, LocalLastChangedAt, OrganizerId, Status;


  action SubmitForApproval result [1] $self;
  action ApproveEvent      result [1] $self;
  action RejectEvent       result [1] $self;
  action CancelEvent       result [1] $self;
  action CloseEvent        result [1] $self;

  validation ValidateEventDates     on save { create; update; }
  validation ValidateCapacity       on save { create; update; }
  validation ValidateEventText      on save { create; update; }
  validation ValidateEventReadiness on save { create; update; }

  determination SetInitialEventValues on modify { create; }
  determination SetInitialCurrency    on modify { create; }
//  determination SetAdminFields        on modify { create; }

  association _Booking { create; with draft; }
  association _Ticket_type { create; with draft; }
  association _Booking_item { create; with draft; }

  mapping for zth_event
  {
    EventId              = event_id;
    EventName            = event_name;
    EventType            = event_type;
    EventDetails         = event_details;
    OrganizerId          = organizer_id;
    Venue                = venue;
    City                 = city;
    StartDate            = start_date;
    EndDate              = end_date;
    Status               = status;
    TotalCapacity        = total_capacity;
    AvailableCapacity    = available_capacity;
    CurrencyCode         = currency_code;
    CreatedBy            = created_by;
    CreatedAt            = created_at;
    LastChangedBy        = last_changed_by;
    LastChangedAt        = last_changed_at;
    LocalLastChangedAt   = local_last_changed_at;
  }
}

define behavior for ZI_TH_BOOKING alias Booking
persistent table zth_booking
draft table zth_booking_d
lock dependent by _Event
authorization dependent by _Event
{
  update;
  delete;


  field ( readonly, numbering : managed ) BookingId;
 field ( readonly ) EventId, CreatedAt, CreatedBy, LastChangedAt, LastChangedBy;

  action ConfirmBooking  result [1] $self;
  action GenerateInvoice result [1] $self;
  action IssueTicket     result [1] $self;
  action CancelBooking   result [1] $self;

  validation ValidateBookingCanIssues on save { create; update; }

  determination SetInitialBookingValues on modify { create; }
//  determination calculateBookingTotals  on modify { create; update; }

  association _Event { with draft; }
//  association _Booking_Item { create; with draft; }

  mapping for zth_booking
  {
      BookingId       = booking_id;
      EventId         = event_id;
      CustomerId      = customer_id;
      BookingDate     = booking_date;
      Status          = status;
      PaymentStatus   = payment_status;
      GrossAmount     = gross_amount;
      DiscountAmount  = discount_amount;
      TaxAmount       = tax_amount;
      NetAmount       = net_amount;
      CurrencyCode    = currency_code;
      CreatedBy       = created_by;
      CreatedAt       = created_at;
      LastChangedBy   = last_changed_by;
      LastChangedAt   = last_changed_at;
  }
}

define behavior for ZI_TH_BOOKING_ITEM alias BookingItem
persistent table zth_booking_item
draft table zth_book_item_d
lock dependent by _Event
authorization dependent by _Event
{
  update;
  delete;

  field ( readonly, numbering : managed ) BookingItemId;
  field ( readonly ) BookingId, EventId, GrossAmount, NetAmount;
  field ( mandatory ) TicketTypeId, Quantity, UnitPrice;

  determination CalculateItemAmount on modify { create; update; }

  validation ValidateItemQuantity   on save { create; update; }

  association _Booking { with draft; }
  association _Event { with draft; }

  mapping for zth_booking_item
  {
      BookingItemId   = booking_item_id;
      BookingId       = booking_id;
      EventId         = event_id;
      TicketTypeId    = ticket_type_id;
      Quantity        = quantity;
      UnitPrice       = unit_price;
      GrossAmount     = gross_amount;
      DiscountAmount  = discount_amount;
      NetAmount       = net_amount;
      CurrencyCode    = currency_code;
      CreatedBy       = created_by;
      CreatedAt       = created_at;
      LastChangedBy   = last_changed_by;
      LastChangedAt   = last_changed_at;
  }
}


define behavior for ZI_TH_TICKET_TYPE alias TicketType
persistent table zth_ticket_type
draft table zth_ticket_typ_d
lock dependent by _Event
authorization dependent by _Event
{
  update;
  delete;

  field ( readonly ) TicketTypeId, EventId;

  association _Event { with draft; }

  mapping for zth_ticket_type
  {
      TicketTypeId          = ticket_type_id;
      EventId               = event_id;
      TicketTypeName        = ticket_type_name;
      CurrencyCode          = currency_code;
      Price                 = price;
      Status                = status;
      TotalQuantity         = total_quantity;
      AvailableQuantity     = available_quantity;
      CreatedBy             = created_by;
      CreatedAt             = created_at;
      LastChangedBy         = last_changed_by;
      LastChangedAt         = last_changed_at;
      LocalLastChangedAt    = local_last_changed_at;
  }
}