@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Event',
    typeNamePlural: 'Events',
    title: {
      type: #STANDARD,
      value: 'EventName'
    },
    description: {
      type: #STANDARD,
      value: 'Venue'
    }
  }
}
annotate view ZC_TH_EVENT with
{
  @UI.facet: [
    {
      id: 'EventGeneral',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Event Details',
      position: 10
    },
    {
      id: 'TicketTypes',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Ticket Types',
      position: 20,
      targetElement: '_Ticket_type'
    },
    {
      id: 'Bookings',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Bookings',
      position: 30,
      targetElement: '_Booking'
    }
  ] 

  @UI.hidden: true
  EventId;

  @UI.lineItem: [
    { position: 10, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 10 }
  ]
  @UI.selectionField: [
    { position: 10 }
  ]
  EventName;

  @UI.lineItem: [
    { position: 20, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 20 }
  ]
  @UI.selectionField: [
    { position: 20 }
  ]
  EventType;

  @UI.lineItem: [
    { position: 30, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 30 }
  ]
  Venue;

  @UI.lineItem: [
    { position: 40, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 40 }
  ]
  City;

  @UI.lineItem: [
    { position: 50, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 50 }
  ]
  countrycode;

  @UI.lineItem: [
    { position: 60, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 60 }
  ]
  @UI.selectionField: [
    { position: 30 }
  ]
  StartDate;

  @UI.lineItem: [
    { position: 70, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 70 }
  ]
  EndDate;

  @UI.lineItem: [
    { position: 80, importance: #HIGH }
  ]
  @UI.identification: [
    { position: 80 }
  ]
  @UI.selectionField: [
    { position: 40 }
  ]
  Status;

  @UI.lineItem: [
    { position: 90, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 90 }
  ]
  TotalCapacity;

  @UI.lineItem: [
    { position: 100, importance: #MEDIUM }
  ]
  @UI.identification: [
    { position: 100 }
  ]
  AvailableCapacity;

  @UI.identification: [
    { position: 110 }
  ]
  CurrencyCode;

  @UI.identification: [
    { position: 120 }
  ]
  OrganizerId;

  @UI.identification: [
    { position: 130 }
  ]
  CreatedBy;

  @UI.identification: [
    { position: 140 }
  ]
  CreatedAt;

  @UI.identification: [
    { position: 150 }
  ]
  LastChangedBy;

  @UI.identification: [
    { position: 160 }
  ]
  LastChangedAt;
}