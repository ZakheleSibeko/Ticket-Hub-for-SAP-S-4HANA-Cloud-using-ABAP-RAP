@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Event',
    typeNamePlural: 'Events',
    title: {
      type: #STANDARD,
      value: 'EventName'
    },
    description: {
      type: #STANDARD,
      value: 'Venue'
    }
  }
}
annotate view ZC_TH_EVENT with
{
  @UI.facet: [
    {
      id: 'EventGeneral',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Event Details',
      position: 10
    },
    {
      id: 'TicketTypes',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Ticket Types',
      position: 20,
      targetElement: '_Ticket_type'
    },
    {
      id: 'Bookings',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Bookings',
      position: 30,
      targetElement: '_Booking'
    }
  ] 

  @UI.hidden: true
  EventId;

  @UI.lineItem: [
    { position: 10, importance: #HIGH, label: 'Event Name' }
  ]
  @UI.identification: [
    { position: 10 }
  ]
  @UI.selectionField: [
    { position: 10 }
  ]
  EventName;

  @UI.lineItem: [
    { position: 20, importance: #HIGH, label: 'Event type' }
  ]
  @UI.identification: [
    { position: 20 }
  ]
  @UI.selectionField: [
    { position: 20 }
  ]
  EventType;

  @UI.lineItem: [
    { position: 30, importance: #HIGH, label: 'Venue' }
  ]
  @UI.identification: [
    { position: 30 }
  ]
  @UI.selectionField: [ { position: 30 } ]
  Venue;

  @UI.lineItem: [
    { position: 40, importance: #MEDIUM, label: 'City' }
  ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.identification: [
    { position: 40 }
  ]
  City;

  @UI.lineItem: [
    { position: 50, importance: #MEDIUM, label: 'Event details' }
  ]
  @UI.identification: [
    { position: 50 }
  ]
  EventDetails;

  @UI.lineItem: [
    { position: 60, importance: #HIGH, label: 'Start date' }
  ]
  @UI.identification: [
    { position: 60 }
  ]
  @UI.selectionField: [
    { position: 60 }
  ]
  StartDate;

  @UI.lineItem: [
    { position: 70, importance: #MEDIUM, label: 'End date' }
  ]
  @UI.identification: [
    { position: 70 }
  ]
  EndDate;

  @UI.lineItem: [
    { position: 170, importance: #HIGH, label: 'Status' }
  ]
  @UI.identification: [
    { position: 170 }
  ]
  Status;

  @UI.lineItem: [
    { position: 90, importance: #MEDIUM, label: 'Total capacity' }
  ]
  @UI.identification: [
    { position: 90 }
  ]
  TotalCapacity;

  @UI.lineItem: [
    { position: 100, importance: #MEDIUM, label: 'Available capacity' }
  ]
  @UI.identification: [
    { position: 100 }
  ]
  AvailableCapacity;

  @UI.lineItem: [ { position: 110, importance: #MEDIUM, label: 'Currency code' } ]
  @UI.identification: [
    { position: 110 }
  ]
  CurrencyCode;

  @UI.lineItem: [ { position: 120, importance: #MEDIUM, label: 'Organizer Id' } ]
  @UI.identification: [
    { position: 120 }
  ]
  OrganizerId;

  @UI.lineItem: [ { position: 130, importance: #MEDIUM, label: 'Created by'} ]
  @UI.identification: [
    { position: 130 }
  ]
  CreatedBy;

  @UI.lineItem: [ { position: 140, importance: #MEDIUM, label: 'Created at'} ]
  @UI.identification: [
    { position: 140 }
  ]
  CreatedAt;

  @UI.lineItem: [ { position: 150, importance: #MEDIUM, label: 'Last changed by'} ]
  @UI.identification: [
    { position: 150 }
  ]
  LastChangedBy;

  @UI.lineItem: [ { position: 160, importance: #MEDIUM, label: 'Last changed at'} ]
  @UI.identification: [
    { position: 160 }
  ]
  LastChangedAt;
}