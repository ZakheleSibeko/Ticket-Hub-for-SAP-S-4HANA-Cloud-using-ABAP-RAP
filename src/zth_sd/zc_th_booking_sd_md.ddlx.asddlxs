@Metadata.layer: #CORE
@UI: { 
     headerInfo: { 
       typeName: 'Booking',
       typeNamePlural: 'Bookings',
       title: { 
            type: #STANDARD,
            value: 'BookingId'
            }, 
       description: {
        type: #STANDARD,
        value: 'BookingDate' 
       }
   }      
}
annotate entity ZC_TH_BOOKING_SD with 
{
@UI.facet: [
    { 
     id: 'BookingGeneral',
     purpose: #STANDARD,
     type: #IDENTIFICATION_REFERENCE,
     label: 'Booking items',
     position: 10
    }
]
// =============================================  
//           List report - table columns
// =============================================
 
   @UI.lineItem: [{ position: 10, importance: #HIGH, label: 'Booking'  }]
   @UI.selectionField: [ { position: 10 } ]
   @UI.identification: [ { position: 10 } ]
   BookingId; 
   
   @UI.lineItem: [ { position: 20, importance: #HIGH, label: 'Customer' }]
   @UI.selectionField: [ { position: 20 } ]
   @UI.identification: [ { position: 20 } ]
   CustomerId; 
   
   @UI.lineItem: [ { position: 30, importance: #HIGH, label: 'Event' }]
   @UI.selectionField: [ { position: 30 } ]
   @UI.identification: [ { position: 30 } ]
   EventId; 
   
   @UI.lineItem: [ { position: 40, importance: #HIGH, label: 'Date' }]
   @UI.selectionField: [ { position: 40 } ]
   @UI.identification: [ { position: 40 } ]
   BookingDate; 
   
   @UI.lineItem: [ { position: 50, importance: #HIGH, label: 'StatusCriticality' }]
   @UI.identification: [ { position: 50 } ]
   Status;
   
   @UI.lineItem: [ { position: 60, importance: #HIGH, label: 'Total amount' }]
   @UI.identification: [ { position: 60 } ]
   TotalAmount;
   
   @UI.lineItem: [ { position: 70, importance: #HIGH, label: 'Currency' }]
   @UI.identification: [ { position: 70 } ]
   CurrencyCode;
   
   // Hidden technical fields from UI
   @UI.hidden: true 
   CreatedBy;
   @UI.hidden: true
   CreatedAt;
   @UI.hidden: true
   LocalLastchangedBy;
   @UI.hidden: true
   LocalLastchangedAt;
   
   
